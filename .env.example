# Copy this file to .env.local and fill in values from
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Calendar reminders (Web Push). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here (and in Vercel). The private key only goes into
# Supabase → Edge Functions → Secrets. Leave empty to hide reminders.
VITE_VAPID_PUBLIC_KEY=
